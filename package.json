{
  "name": "digital-knowledge-network",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first pipeline for turning captured material into an auditable knowledge graph.",
  "type": "module",
  "bin": {
    "dkn": "./dist/server/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "app": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "start": "node dist/server/server.js",
    "sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-workflow.ps1",
    "models:start": "powershell -ExecutionPolicy Bypass -File scripts/start-model.ps1",
    "models:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-models.ps1",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "playwright": "^1.62.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "fastify": "^5.12.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "tesseract.js": "^7.0.0"
  }
}
