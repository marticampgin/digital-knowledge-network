# Any OpenAI-compatible local server (llama.cpp, LM Studio, etc.)
DKN_LLM_BASE_URL=http://127.0.0.1:8080/v1
DKN_LLM_MODEL=LiquidAI/LFM2.5-2.6B
# Most local servers ignore the key, but the API shape requires one.
DKN_LLM_API_KEY=local

# Telegram: keep the bot token only in your local .env file.
TELEGRAM_BOT_TOKEN=
# Optional after running: npm run dev -- telegram discover
TELEGRAM_CHAT_ID=

# Local storage and application server
DKN_DATA_DIR=.dkn
DKN_DB_PATH=.dkn/knowledge.sqlite
DKN_PORT=4174
